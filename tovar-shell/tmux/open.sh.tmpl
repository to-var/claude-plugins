#!/bin/sh
# Opens the menu popup (skin: {{skin}}). Written by tovar-shell, do not edit by hand.
# Args: pane_id window_id session_id client_name
exec tmux display-popup -c "$4" -E -w 84 -h 28 -b {{popup_border}} \
  -s 'bg=colour{{bg}},fg=colour{{text}}' -S 'fg=colour{{accent}},bg=colour{{bg}}' \
  python3 "{{dir}}/menu.py" "$1" "$2" "$3"
